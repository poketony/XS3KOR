@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
rem 원문을 다시 추출할 때만 .bat로 이름을 바꾸고, 사용 후 .batlock으로 돌리세요.
rem 등록된 29개 원본에서 일본어 TXT를 추출합니다. 기존 TXT가 하나라도 있으면 전체 중단합니다.
rem 내부 라벨만 있는 나머지 SB는 번역 대상으로 추출하지 않습니다.
rem 단일 추출 명령: python tools/x30/build_sb.py --asset bat/REN_B01 --extract
python -X utf8 -B "%~dp0..\..\..\tools\x30\build_sb.py" --group bat --extract %*
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" echo 기존 TXT와 오류 내용을 확인하세요. 작업 TXT는 덮어쓰지 않습니다.
if not defined XS3_NO_PAUSE pause
exit /b %RESULT%
