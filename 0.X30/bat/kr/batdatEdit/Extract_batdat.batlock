@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
rem 원문 재추출 시에만 확장자를 .bat로 바꾸고, 사용 후 .batlock으로 돌리세요.
rem 같은 폴더의 원본 batdat.bin에서 일본어 batdat.json을 추출합니다.
rem 기존 batdat.json이 있으면 실패하며 절대 덮어쓰지 않습니다.
rem 현재 번역을 유지한 전체 항목 검토본이 필요하면 patch.bat --export-editor "새 경로.json"을 사용하세요.
python -X utf8 -B "%~dp0..\..\..\..\tools\x30\build_batdat.py" --extract %*
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" echo 추출 실패: 기존 JSON과 오류 내용을 확인하세요.
if not defined XS3_NO_PAUSE pause
exit /b %RESULT%
