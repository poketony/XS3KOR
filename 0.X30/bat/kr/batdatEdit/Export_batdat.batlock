@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
rem 현재 번역을 포함한 전체 구조 검토본을 만들 때만 .bat로 바꾸고, 사용 후 .batlock으로 돌리세요.
rem 원문 추출과 다릅니다. 기존 번역은 유지하고 누락된 필드만 원문으로 포함합니다.
rem 기본 입력은 이 폴더의 batdat.json이며, JSON 하나를 드롭해 다른 작업본도 검토할 수 있습니다.
rem 출력은 이 폴더의 batdat.expanded.json입니다. 이미 존재하면 중단하며 덮어쓰지 않습니다.
rem 검토본을 patch.bat에 드롭하면 시험 리빌드합니다. 기본 작업 JSON은 자동 교체하지 않습니다.
python -X utf8 -B "%~dp0..\..\..\..\tools\x30\build_batdat.py" --export-editor "%~dp0batdat.expanded.json" %*
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" echo 검토본 내보내기 실패: 기존 파일과 오류 내용을 확인하세요.
if not defined XS3_NO_PAUSE pause
exit /b %RESULT%
