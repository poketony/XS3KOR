@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
rem 필요할 때만 확장자를 .bat으로 바꾸어 실행하세요.
rem ESP 45개에서 *.location.png를 추출합니다. 기존 PNG가 있으면 전체 중단합니다.
rem 원본 ESP는 기존 한글 수정이 들어 있을 수 있으며 그대로 읽기만 합니다.
python -X utf8 -B "%~dp0..\..\..\tools\x30\build_effects.py" --group map --extract %*
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" echo 추출하지 않았거나 중간 오류가 발생했습니다. 기존 PNG를 확인하세요.
if not defined XS3_NO_PAUSE pause
exit /b %RESULT%
