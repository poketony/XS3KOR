@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
rem 원문 재추출 시에만 .bat로 바꾸고 끝나면 .batlock으로 되돌리세요.
rem 기본 실행: MES 6개의 일본어 원문을 등록된 작업 TXT 이름으로 추출합니다.
rem --asset EP1처럼 이름을 주면 하나만 처리합니다. 이름: AC, EP1, EP2, opening, PP, test
rem --check는 저장 없이 검사합니다. 선택한 TXT가 하나라도 존재하면 전체 저장을 중단합니다.
rem 기존 번역은 덮어쓰지 않으며 자동 백업/자동 번역하지 않습니다.
python -X utf8 -B "%~dp0..\..\..\..\tools\x30\build_pse.py" --extract %*
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" echo 추출 실패: 기존 TXT와 오류 내용을 확인하세요.
if not defined XS3_NO_PAUSE pause
exit /b %RESULT%
