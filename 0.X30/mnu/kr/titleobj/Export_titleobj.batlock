@echo off
chcp 65001 >nul
setlocal DisableDelayedExpansion
rem 필요할 때만 확장자를 .bat로 바꿔 실행하고 다시 .batlock으로 되돌리세요.
rem 이 폴더의 titleobj.xtx에서 원본 PNG 5장을 추출합니다. 기존 PNG가 있으면 모두 거부합니다.
rem --check는 저장 없이 원본 추출과 재삽입의 바이트 일치를 검사합니다.
python -X utf8 -B "%~dp0..\..\..\..\tools\x30\build_title.py" --extract %*
set "BUILD_RESULT=%ERRORLEVEL%"
if not "%BUILD_RESULT%"=="0" echo EXPORT FAILED. Existing editors are never overwritten.
if not defined XS3_NO_PAUSE pause
exit /b %BUILD_RESULT%
