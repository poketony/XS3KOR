@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
rem 원문 재추출 시에만 확장자를 .bat로 바꾸고 끝나면 .batlock으로 되돌리세요.
rem 기본 실행: 등록된 메뉴 9종의 일본어 원문을 기존 작업 TXT 이름으로 추출합니다.
rem --asset devchk처럼 이름을 주면 하나만 추출합니다. --check는 추출 가능 여부만 검사합니다.
rem 지원 이름: njDataText, MVtext, SegmentFileData, njDBcommon, njBtlText, devchk, discchg, menutext, synopsis
rem 선택한 TXT가 하나라도 이미 있으면 전체 저장을 중단합니다. 번역문을 덮어쓰거나 자동 백업하지 않습니다.
rem DBC/DBC2는 별도의 Extract_database.batlock을 사용하세요.
python -X utf8 -B "%~dp0..\..\..\tools\x30\build_menu.py" --extract %*
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" echo 추출 실패: 기존 TXT와 오류 내용을 확인하세요.
if not defined XS3_NO_PAUSE pause
exit /b %RESULT%
