@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
rem 실수 실행 방지: 원문을 다시 추출할 때만 확장자를 .bat로 바꾸고, 끝나면 .batlock으로 돌리세요.
rem 원본 SB에서 일본어 TXT를 추출합니다. 기존 TXT가 하나라도 있으면 전체 저장을 중단합니다.
rem --asset cf/8050: 한 원본만 선택합니다. 이 경우 아래 --group cf 대신 --asset을 직접 실행하세요.
rem 단일 추출 명령: python tools/x30/build_sb.py --asset cf/8050 --extract
rem 작업 TXT를 덮어쓰지 않습니다. 재추출 전 필요한 TXT는 사용자가 별도로 보관해야 합니다.
python -X utf8 -B "%~dp0..\..\..\tools\x30\build_sb.py" --group cf --extract %*
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" echo 추출 실패: 기존 TXT와 오류 내용을 확인하세요. 기존 번역은 덮어쓰지 않습니다.
if not defined XS3_NO_PAUSE pause
exit /b %RESULT%
